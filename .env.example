# PaperMemory local development settings

# Runtime
PAPERMEMORY_ENVIRONMENT=development

# API
PAPERMEMORY_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Local storage
PAPERMEMORY_STORAGE_ROOT=./storage
PAPERMEMORY_MAX_UPLOAD_BYTES=104857600
PAPERMEMORY_MAX_PDF_PAGES=200
PAPERMEMORY_PDF_RENDER_ZOOM=2.0

# Qdrant
# server = Docker/server Qdrant at PAPERMEMORY_QDRANT_URL.
# local = embedded qdrant-client storage at PAPERMEMORY_QDRANT_LOCAL_PATH.
PAPERMEMORY_QDRANT_MODE=server
PAPERMEMORY_QDRANT_URL=http://localhost:6333
PAPERMEMORY_QDRANT_LOCAL_PATH=storage/qdrant_local
PAPERMEMORY_QDRANT_COLLECTION=papermemory_pages
# Keep 8 while the development stub embedder is active. Use 2304 when the real
# openbmb/VisRAG-Ret embedding path is enabled.
PAPERMEMORY_QDRANT_VECTOR_SIZE=8
PAPERMEMORY_QDRANT_DISTANCE=Cosine
PAPERMEMORY_QDRANT_TIMEOUT_SECONDS=5

# Retrieval
PAPERMEMORY_VISRAG_BACKEND=stub
PAPERMEMORY_VISRAG_MODEL_NAME=openbmb/VisRAG-Ret
PAPERMEMORY_VISRAG_INSTRUCTION="Represent this query for retrieving relevant documents:"
PAPERMEMORY_VISRAG_DEVICE=auto
PAPERMEMORY_VISRAG_DTYPE=auto
PAPERMEMORY_VISRAG_TRUST_REMOTE_CODE=false
PAPERMEMORY_VISRAG_BATCH_SIZE=4

# Real VisRAG-Ret mode requires the optional API extra, a large Hugging Face
# model download, Hugging Face custom code, and a Qdrant collection sized for
# 2304-dimensional embeddings:
#   pip install -e "./apps/api[visrag]"
#   PAPERMEMORY_VISRAG_BACKEND=transformers
#   PAPERMEMORY_VISRAG_TRUST_REMOTE_CODE=true
#   PAPERMEMORY_QDRANT_VECTOR_SIZE=2304

# BYOK generation
# Prefer session-only user-provided keys in the app. These values are for local
# developer testing and should never be committed with real secrets.
PAPERMEMORY_BYOK_BASE_URL=https://api.openai.com/v1
PAPERMEMORY_BYOK_MODEL=gpt-4o
PAPERMEMORY_BYOK_API_KEY=
PAPERMEMORY_BYOK_TIMEOUT_SECONDS=60
PAPERMEMORY_BYOK_ENABLE_IMAGE_CONTEXT=true
PAPERMEMORY_BYOK_MAX_EVIDENCE_IMAGES=3
PAPERMEMORY_BYOK_MAX_IMAGE_BYTES=2097152

# Hosted/collaboration placeholders
# Keep disabled for local-first MVP. Future hosted deployments should define
# explicit auth, workspace, data-retention, and secret-storage policies.
PAPERMEMORY_HOSTED_MODE=false
